    <!-- Detection Reasons -->
    <string name="reason_urgent_language">ಸಂದೇಶವು ತುರ್ತುವನ್ನು ಸೃಷ್ಟಿಸುತ್ತದೆ ಮತ್ತು ತಕ್ಷಣ ಕಾರ್ಯ ಮಾಡಲು ಮಗ್ಗಿ ಹಾಕುತ್ತದೆ.</string>
    <string name="reason_account_threat">ಸಂದೇಶವು ಖಾತೆ ನಿರ್ಬಂಧ ಅಥವಾ ನಿಲಗಡೆಯ ಬೆದರಿಕೆ ಯೊಡ್ಡಿದೆ.</string>
    <string name="reason_kyc_pressure">ಸಂದೇಶವು KYC ಪೂರ್ಣಗೊಳಿಸಲು ಅಥವಾ ನವೀಕರಿಸಲು ಮಗ್ಗಿ ಹಾಕುತ್ತದೆ.</string>
    <string name="reason_impersonation">ಸಂದೇಶವು ಅಧಿಕಾರಿ, ಬ್ಯಾಂಕ್ ಅಥವಾ ಅಧಿಕೃತ ಸೇವೆಯನ್ನು ನಟಿಸುತ್ತಿರುವಂತೆ ಕಾಣುತ್ತದೆ.</string>
    <string name="reason_credential_request">ಸಂದೇಶವು OTP, PIN ಅಥವಾ ಕಾರ್ಡ್ ವಿವರಗಳಂತಹ ಸಂವೇದನಶೀಲ ಮಾಹಿತಿಯನ್ನು ಕೇಳುತ್ತದೆ.</string>
    <string name="reason_payment_pressure">ಸಂದೇಶವು ಪಾವತಿ ಮಾಡಲು ಅಥವಾ ಹಟ್ಟ ವರ್ಗಾಯಿಸಲು ಮಗ್ಗಿ ಹಾಕುತ್ತದೆ.</string>
    <string name="reason_suspicious_intent">ಸಂದೇಶವು ಹಂಡಾಣಿಕೆ ಕ್ರಮವನ್ನು ಯಾಚನೆ, ಅನ್ಲಾಕ್, ಮರುಪಾವತಿ ಅಥವಾ ಬಹುಮಾನದೊಂದಿಗೆ ಜೋಡಿಸುತ್ತದೆ.</string>
    <string name="reason_lottery_prize">ಸಂದೇಶವು ಬಹುಮಾನ ಅಥವಾ ಲಾಟರಿಯನ್ನು ಸೂಚಿಸುವ ಭಾಷೆ ಬಳಸುತ್ತದೆ ಇದು ಸಾಮಾನ್ಯವಾಗಿ ವಂಚನೆಗಳೊಂದಿಗೆ ಸಂಬಂಧಿಸಿದೆ.</string>
    <string name="reason_refund_reward">ಸಂದೇಶವು ಕ್ರಮ ತೆಗೆದುಕೊಳ್ಳಲು ಪ್ರೋತ್ಸಾಹಿಸಲು ಮರುಪಾವತಿ, ಕ್ಯಾಶ್ಬ್ಯಾಕ್ ಅಥವಾ ಬಹುಮಾನದ ಮೂಲಕ ಗಮನ ಹೆಳುತ್ತದೆ.</string>

